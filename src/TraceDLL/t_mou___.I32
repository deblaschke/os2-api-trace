;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;                                                                              ;
;  File name    : T_MOU___.I32                                                 ;
;                                                                              ;
;  Title        : OS/2 API Intel trace DLL MOUCALLS module definitions file    ;
;                                                                              ;
;  Author       : Dave Blaschke                                                ;
;                 deblaschke@yahoo.com                                         ;
;                                                                              ;
;  History      : Version Date    Item                                         ;
;                 2.40.19 01May97 Added 16-bit Mou APIs                        ;
;                 2.45.18 28Feb00 Removed import by name restriction           ;
;                 2.45.31 26Jun01 Added  capability  of building  32-bit  only ;
;                                 trace DLLs                                   ;
;                                                                              ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
LIBRARY         T_MOU___ INITINSTANCE TERMINSTANCE
DESCRIPTION     'OS/2 API Intel Trace DLL MOUCALLS Dynamic Link Library'
EXETYPE         OS2
PROTMODE
DATA            MULTIPLE NONSHARED
SEGMENTS
                CODE32 CLASS 'CODE'
                _MSGSEG32 CLASS 'CODE'
EXPORTS
                MOUGETPTRSHAPE                            @ 1 RESIDENTNAME
                MOUSETPTRSHAPE                            @ 2 RESIDENTNAME
                MOUGETNUMMICKEYS                          @ 3 RESIDENTNAME
                                   MOUGETHOTKEY           @ 4 RESIDENTNAME
                                   MOUSHELLINIT           @ 5 NONAME
                MOUGETSCALEFACT                           @ 6 RESIDENTNAME
                MOUFLUSHQUE                               @ 7 RESIDENTNAME
                MOUGETNUMBUTTONS                          @ 8 RESIDENTNAME
                MOUCLOSE                                  @ 9 RESIDENTNAME
                                   MOUSETHOTKEY           @10 RESIDENTNAME
                MOUSETSCALEFACT                           @11 RESIDENTNAME
                MOUGETNUMQUEEL                            @13 RESIDENTNAME
                MOUDEREGISTER                             @14 RESIDENTNAME
                MOUGETEVENTMASK                           @15 RESIDENTNAME
                MOUSETEVENTMASK                           @16 RESIDENTNAME
                MOUOPEN                                   @17 RESIDENTNAME
                MOUREMOVEPTR                              @18 RESIDENTNAME
                MOUGETPTRPOS                              @19 RESIDENTNAME
                MOUREADEVENTQUE                           @20 RESIDENTNAME
                MOUSETPTRPOS                              @21 RESIDENTNAME
                MOUGETDEVSTATUS                           @22 RESIDENTNAME
                MOUSYNCH                                  @23 RESIDENTNAME
                MOUREGISTER                               @24 RESIDENTNAME
                MOUSETDEVSTATUS                           @25 RESIDENTNAME
                MOUDRAWPTR                                @26 RESIDENTNAME
                MOUINITREAL                               @27 RESIDENTNAME
                MOUGETTHRESHOLD                           @29 RESIDENTNAME
                MOUSETTHRESHOLD                           @30 RESIDENTNAME
IMPORTS
                MOUGETPTRSHAPE   = MOUCALLS. 1
                MOUSETPTRSHAPE   = MOUCALLS. 2
                MOUGETNUMMICKEYS = MOUCALLS. 3
                MOUGETHOTKEY     = MOUCALLS. 4
                MOUSHELLINIT     = MOUCALLS. 5
                MOUGETSCALEFACT  = MOUCALLS. 6
                MOUFLUSHQUE      = MOUCALLS. 7
                MOUGETNUMBUTTONS = MOUCALLS. 8
                MOUCLOSE         = MOUCALLS. 9
                MOUSETHOTKEY     = MOUCALLS.10
                MOUSETSCALEFACT  = MOUCALLS.11
                MOUGETNUMQUEEL   = MOUCALLS.13
                MOUDEREGISTER    = MOUCALLS.14
                MOUGETEVENTMASK  = MOUCALLS.15
                MOUSETEVENTMASK  = MOUCALLS.16
                MOUOPEN          = MOUCALLS.17
                MOUREMOVEPTR     = MOUCALLS.18
                MOUGETPTRPOS     = MOUCALLS.19
                MOUREADEVENTQUE  = MOUCALLS.20
                MOUSETPTRPOS     = MOUCALLS.21
                MOUGETDEVSTATUS  = MOUCALLS.22
                MOUSYNCH         = MOUCALLS.23
                MOUREGISTER      = MOUCALLS.24
                MOUSETDEVSTATUS  = MOUCALLS.25
                MOUDRAWPTR       = MOUCALLS.26
                MOUINITREAL      = MOUCALLS.27
                MOUGETTHRESHOLD  = MOUCALLS.29
                MOUSETTHRESHOLD  = MOUCALLS.30
