;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;                                                                              ;
;  File name    : T_PIP___.I32                                                 ;
;                                                                              ;
;  Title        : OS/2 API Intel trace DLL NAMPIPES module definitions file    ;
;                                                                              ;
;  Author       : Dave Blaschke                                                ;
;                 deblaschke@yahoo.com                                         ;
;                                                                              ;
;  History      : Version Date    Item                                         ;
;                 2.40.17 21Apr97 Added 16-bit Dos APIs                        ;
;                 2.45.18 28Feb00 Removed import by name restriction           ;
;                 2.45.31 26Jun01 Added  capability  of building  32-bit  only ;
;                                 trace DLLs                                   ;
;                                                                              ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
LIBRARY         T_PIP___ INITINSTANCE TERMINSTANCE
DESCRIPTION     'OS/2 API Intel Trace DLL NAMPIPES Dynamic Link Library'
EXETYPE         OS2
PROTMODE
DATA            MULTIPLE NONSHARED
SEGMENTS
                CODE32 CLASS 'CODE'
                _MSGSEG32 CLASS 'CODE'
EXPORTS
                DOSMAKENMPIPE                                   @ 1 RESIDENTNAME
                DOSQNMPIPEINFO                                  @ 2 RESIDENTNAME
                DOSCONNECTNMPIPE                                @ 3 RESIDENTNAME
                DOSDISCONNECTNMPIPE                             @ 4 RESIDENTNAME
                DOSQNMPHANDSTATE                                @ 5 RESIDENTNAME
                DOSSETNMPHANDSTATE                              @ 6 RESIDENTNAME
                DOSPEEKNMPIPE                                   @ 7 RESIDENTNAME
                DOSWAITNMPIPE                                   @ 8 RESIDENTNAME
                DOSTRANSACTNMPIPE                               @ 9 RESIDENTNAME
                DOSCALLNMPIPE                                   @10 RESIDENTNAME
                DOSRAWREADNMPIPE                                @11 RESIDENTNAME
                DOSRAWWRITENMPIPE                               @12 RESIDENTNAME
                DOSSETNMPIPESEM                                 @13 RESIDENTNAME
                DOSQNMPIPESEMSTATE                              @14 RESIDENTNAME
IMPORTS
                DOSMAKENMPIPE       = NAMPIPES. 1
                DOSQNMPIPEINFO      = NAMPIPES. 2
                DOSCONNECTNMPIPE    = NAMPIPES. 3
                DOSDISCONNECTNMPIPE = NAMPIPES. 4
                DOSQNMPHANDSTATE    = NAMPIPES. 5
                DOSSETNMPHANDSTATE  = NAMPIPES. 6
                DOSPEEKNMPIPE       = NAMPIPES. 7
                DOSWAITNMPIPE       = NAMPIPES. 8
                DOSTRANSACTNMPIPE   = NAMPIPES. 9
                DOSCALLNMPIPE       = NAMPIPES.10
                DOSRAWREADNMPIPE    = NAMPIPES.11
                DOSRAWWRITENMPIPE   = NAMPIPES.12
                DOSSETNMPIPESEM     = NAMPIPES.13
                DOSQNMPIPESEMSTATE  = NAMPIPES.14
