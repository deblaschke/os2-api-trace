                                                 UNLOCKVIOPS                    @ 28 RESIDENTNAME
                                                 MARKINGWINDOWPROC              @ 29 RESIDENTNAME
                WINDEFAVIOWINDOWPROC           = TRC_WIN16DEFAVIOWINDOWPROC     @ 30 RESIDENTNAME
                                                 WINCONSOLEGETKBDHANDLE         @ 31 RESIDENTNAME
                                                 WINCONSOLEATTACHMOUSEUSER      @ 32 RESIDENTNAME
                                                 WINCONSOLEDETACHMOUSEUSER      @ 33 RESIDENTNAME
                                                 TASKMGRSUBCLASSPROC            @ 34 RESIDENTNAME
                                                 WINSHIELDPRETHAW               @ 35 RESIDENTNAME
                                                 WININITSHIELD                  @ 36 RESIDENTNAME
                                                 MORTICIAN                      @ 37 RESIDENTNAME
                                                 UNLOCKSEMAPHORES               @ 39 RESIDENTNAME
                                                 CLEARDATA                      @ 40 RESIDENTNAME
                                                 QUERYCONSOLE                   @ 41 RESIDENTNAME
                                                 MAKEVISIBLE                    @ 42 RESIDENTNAME
                                                 GETPASTECHAR                   @ 43 RESIDENTNAME
