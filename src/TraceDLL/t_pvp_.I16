                                                 SEAMLESSCONTROLPROC            @ 45 RESIDENTNAME ; Removed OS2VER 230
                                                 TERMINATECLIPDDE               @ 46 RESIDENTNAME ; OS2VER 210
                                                 VDMCLIPDDENOTIFY               @ 47 RESIDENTNAME ; OS2VER 210
                                                 PM32CLIPDDENOTIFY              @ 49 RESIDENTNAME ; OS2VER 210
                                                 SEAMLESS32REGISTEROBJECT       @ 50 RESIDENTNAME ; OS2VER 210, removed OS2VER 230
                                                 SEAMLESS32ACTIVATEWINDOW       @ 51 RESIDENTNAME ; OS2VER 210, removed OS2VER 230
                                                 NOTIFYALLVDMS                  @ 52 RESIDENTNAME ; OS2VER 210
                                                 VDMSWAPBUTTONNOTIFY            @ 53 RESIDENTNAME ; OS2VER 210
                                                 GET32DISPLAYTYPE               @ 54 RESIDENTNAME ; OS2VER 210
                                                 SEAMLESS32REGISTERASSOCOBJ     @ 55 RESIDENTNAME ; OS2VER 210, removed OS2VER 230
                                                 VDMREGISTERHOOK                @ 56 RESIDENTNAME ; OS2VER 210
                                                 VDMDEREGISTERHOOK              @ 57 RESIDENTNAME ; OS2VER 210
                                                 SCREENGROUPTOFPCONSOLE         @101 RESIDENTNAME ; OS2VER 230
                                                 APFNVDMSERV                    @102 RESIDENTNAME ; OS2VER 230
                                                 GETSELACCESS                   @103 RESIDENTNAME ; OS2VER 230
                                                 NPSZSTRINGS                    @104 RESIDENTNAME ; OS2VER 230
                                                 KEYBOARDEVENT                  @105 RESIDENTNAME ; OS2VER 230
                                                 ESTABLISHKBDENVIRONMENT        @106 RESIDENTNAME ; OS2VER 230
                                                 HMYMODULEHANDLE                @107 RESIDENTNAME ; OS2VER 230
                                                 FSEAMLESSCAPTURED              @108 RESIDENTNAME ; OS2VER 230
                                                 HMQTASKMGR                     @110 RESIDENTNAME ; OS2VER 230
                                                 PCHARXLATETBLDEFAULT           @111 RESIDENTNAME ; OS2VER 230
                                                 HAPPSEAMLESSCOMMONVDM          @112 RESIDENTNAME ; OS2VER 230
                                                 HAPPSEAMLESSCOMMONVDM31        @114 RESIDENTNAME ; OS2VER 230
                                                 HAPPSEAMLESSCOMMONVDM31ENH     @116 RESIDENTNAME ; OS2VER 230
                                                 FKBDHOOK                       @117 RESIDENTNAME ; OS2VER 230
                                                 FMOUHOOK                       @118 RESIDENTNAME ; OS2VER 230
                                                 SELCOMMONLIST                  @119 RESIDENTNAME ; OS2VER 230
                                                 USCOMMONSEGSIZE                @120 RESIDENTNAME ; OS2VER 230
                                                 HMODSEAMLESS                   @121 RESIDENTNAME ; OS2VER 230
                                                 HFRAMEWINDOWFROMCONSOLE        @122 RESIDENTNAME ; OS2VER 245
