;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
LIBRARY         T_PVP_ INITINSTANCE TERMINSTANCE
DESCRIPTION     'OS/2 API Intel Trace DLL PMVIOP Dynamic Link Library'
EXETYPE         OS2
PROTMODE
DATA            MULTIPLE NONSHARED
SEGMENTS
                CODE32 CLASS 'CODE'
                _MSGSEG32 CLASS 'CODE'
                CODE16 CLASS 'CODE' CONFORMING IOPL
                'SEG16_.\t_pvp_0' CLASS 'CODE' CONFORMING IOPL
EXPORTS
                                                 WINCREATECONSOLE               @  1 RESIDENTNAME
                                                 WINDESTROYCONSOLE              @  2 RESIDENTNAME
                                                 WINSYNCWITHPS                  @  3 RESIDENTNAME
                                                 WINCONSOLEOPENKBD              @  4 RESIDENTNAME
                                                 WINCONSOLECLOSEKBD             @  5 RESIDENTNAME
