                VIOASSOCIATE         = TRC_VIO16ASSOCIATE         @55 RESIDENTNAME
                VIOCREATEPS          = TRC_VIO16CREATEPS          @56 RESIDENTNAME
                VIODELETESETID       = TRC_VIO16DELETESETID       @57 RESIDENTNAME
                VIOGETDEVICECELLSIZE = TRC_VIO16GETDEVICECELLSIZE @58 RESIDENTNAME
                VIOGETORG            = TRC_VIO16GETORG            @59 RESIDENTNAME
                VIOCREATELOGFONT     = TRC_VIO16CREATELOGFONT     @60 RESIDENTNAME
                VIODESTROYPS         = TRC_VIO16DESTROYPS         @61 RESIDENTNAME
                VIOQUERYSETIDS       = TRC_VIO16QUERYSETIDS       @62 RESIDENTNAME
