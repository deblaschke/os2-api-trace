;                                                                              ;
;  History      : Version Date    Item                                         ;
;                 2.40.20 05May97 Added 16-bit Vio APIs                        ;
;                 2.40.71 22Oct98 Added PM AVIO Vio APIs                       ;
;                 2.45.18 28Feb00 Removed import by name restriction           ;
;                                                                              ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
LIBRARY         T_VIO___ INITINSTANCE TERMINSTANCE
DESCRIPTION     'OS/2 API Intel Trace DLL VIOCALLS Dynamic Link Library'
EXETYPE         OS2
PROTMODE
DATA            MULTIPLE NONSHARED
SEGMENTS
                CODE32 CLASS 'CODE'
                _MSGSEG32 CLASS 'CODE'
                CODE16 CLASS 'CODE' CONFORMING IOPL
                'SEG16_.\t_vio___0' CLASS 'CODE' CONFORMING IOPL
EXPORTS
                VIOENDPOPUP          = TRC_VIO16ENDPOPUP          @ 1 RESIDENTNAME
                VIOGETPHYSBUF        = TRC_VIO16GETPHYSBUF        @ 2 RESIDENTNAME
                VIOGETANSI           = TRC_VIO16GETANSI           @ 3 RESIDENTNAME
                                       VIOFREE                    @ 4 NONAME
                VIOSETANSI           = TRC_VIO16SETANSI           @ 5 RESIDENTNAME
                VIODEREGISTER        = TRC_VIO16DEREGISTER        @ 6 RESIDENTNAME
                VIOSCROLLUP          = TRC_VIO16SCROLLUP          @ 7 RESIDENTNAME
