                                       XVIOCHECKCHARTYPE          @72 RESIDENTNAME
                                       XVIODESTROYCA              @73 RESIDENTNAME
                                       XVIOCREATECA               @74 RESIDENTNAME
                VIOCHECKCHARTYPE     = TRC_VIO16CHECKCHARTYPE     @75 RESIDENTNAME
                                       XVIOGETCASTATE             @76 RESIDENTNAME
