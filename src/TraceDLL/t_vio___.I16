                VIOGETCURPOS         = TRC_VIO16GETCURPOS         @ 9 RESIDENTNAME
                VIOWRTCELLSTR        = TRC_VIO16WRTCELLSTR        @10 RESIDENTNAME
                VIOPOPUP             = TRC_VIO16POPUP             @11 RESIDENTNAME
                VIOSCROLLRT          = TRC_VIO16SCROLLRT          @12 RESIDENTNAME
