                                       VIOINIT                    @39 NONAME
                VIOGETCP             = TRC_VIO16GETCP             @40 RESIDENTNAME
                                       VIORESTORE                 @41 NONAME
                VIOSETCP             = TRC_VIO16SETCP             @42 RESIDENTNAME
                VIOSHOWBUF           = TRC_VIO16SHOWBUF           @43 RESIDENTNAME
                VIOSCROLLLF          = TRC_VIO16SCROLLLF          @44 RESIDENTNAME
                VIOREGISTER          = TRC_VIO16REGISTER          @45 RESIDENTNAME
                VIOGETCONFIG         = TRC_VIO16GETCONFIG         @46 RESIDENTNAME
                VIOSCROLLDN          = TRC_VIO16SCROLLDN          @47 RESIDENTNAME
                VIOWRTCHARSTRATT     = TRC_VIO16WRTCHARSTRATT     @48 RESIDENTNAME
                VIOGETSTATE          = TRC_VIO16GETSTATE          @49 RESIDENTNAME
