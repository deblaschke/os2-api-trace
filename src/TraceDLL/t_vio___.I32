;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;                                                                              ;
;  File name    : T_VIO___.I32                                                 ;
;                                                                              ;
;  Title        : OS/2 API Intel trace DLL VIOCALLS module definitions file    ;
;                                                                              ;
;  Author       : Dave Blaschke                                                ;
;                 deblaschke@yahoo.com                                         ;
;                                                                              ;
;  History      : Version Date    Item                                         ;
;                 2.40.20 05May97 Added 16-bit Vio APIs                        ;
;                 2.40.71 22Oct98 Added PM AVIO Vio APIs                       ;
;                 2.45.18 28Feb00 Removed import by name restriction           ;
;                 2.45.31 26Jun01 Added  capability  of building  32-bit  only ;
;                                 trace DLLs                                   ;
;                                                                              ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
LIBRARY         T_VIO___ INITINSTANCE TERMINSTANCE
DESCRIPTION     'OS/2 API Intel Trace DLL VIOCALLS Dynamic Link Library'
EXETYPE         OS2
PROTMODE
DATA            MULTIPLE NONSHARED
SEGMENTS
                CODE32 CLASS 'CODE'
                _MSGSEG32 CLASS 'CODE'
EXPORTS
                VIOENDPOPUP                                       @ 1 RESIDENTNAME
                VIOGETPHYSBUF                                     @ 2 RESIDENTNAME
                VIOGETANSI                                        @ 3 RESIDENTNAME
                                       VIOFREE                    @ 4 NONAME
                VIOSETANSI                                        @ 5 RESIDENTNAME
                VIODEREGISTER                                     @ 6 RESIDENTNAME
                VIOSCROLLUP                                       @ 7 RESIDENTNAME
                VIOPRTSC                                          @ 8 RESIDENTNAME
