   HELPITEM DLG_OPTSAPI, HLP_DLG_OPTSAPI, PNL_DLG_OPTSAPI
   HELPITEM DLG_OPTSLEN, HLP_DLG_OPTSLEN, PNL_DLG_OPTSLEN
   HELPITEM DLG_HELPINFO, HLP_DLG_HELPINFO, PNL_ID_MAINWIN
END

/******************************************************************************/
/*                                                                            */
/* Main window menu, accelerator table, icon, and help subtable               */
/*                                                                            */
/******************************************************************************/

MENU ID_MAINWIN
BEGIN
   SUBMENU     "~Enable", IDM_ENABMENU, MIS_TEXT
   BEGIN
      MENUITEM "~Open file...", IDM_ENABOPEN, MIS_TEXT
      MENUITEM "~Preserve file date/time stamp", IDM_ENABPDTS, MIS_TEXT
   END
   SUBMENU     "~Customize", IDM_CUSTMENU, MIS_TEXT
   BEGIN
      MENUITEM "~Alternative directory...", IDM_CUSTALT, MIS_TEXT
      MENUITEM "~Buffer length...", IDM_CUSTBUF, MIS_TEXT
      MENUITEM "Tracing ~control...", IDM_CUSTCTL, MIS_TEXT
      MENUITEM "~DOSCALLS APIs...", IDM_CUSTDOS, MIS_TEXT
      MENUITEM "~EBCDIC translation...", IDM_CUSTEBC, MIS_TEXT
      MENUITEM "~File wrapping...", IDM_CUSTFIL, MIS_TEXT
      MENUITEM "PM~GPI APIs...", IDM_CUSTGPI, MIS_TEXT
      MENUITEM "API ~interception...", IDM_CUSTINT, MIS_TEXT
      MENUITEM "~Logging level...", IDM_CUSTLVL, MIS_TEXT
      MENUITEM "~Time stamping...", IDM_CUSTTIM, MIS_TEXT
#ifdef T_USERHOOK
      MENUITEM "~User hook...", IDM_CUSTUSR, MIS_TEXT
#endif
      MENUITEM "PM~WIN APIs...", IDM_CUSTWIN, MIS_TEXT
   END
   SUBMENU     "Co~ntrol", IDM_CTLMENU, MIS_TEXT
   BEGIN
      MENUITEM "~Pause tracing", IDM_CTLPAUSE, MIS_TEXT
      MENUITEM "~Resume tracing", IDM_CTLRESUME, MIS_TEXT
   END
   SUBMENU     "~Summarize", IDM_SUMMENU, MIS_TEXT
   BEGIN
      MENUITEM "~Open file...", IDM_SUMOPEN, MIS_TEXT
   END
   SUBMENU     "~Options", IDM_OPTSMENU, MIS_TEXT
   BEGIN
      MENUITEM "~Launch .EXE/.COM files", IDM_OPTSEXE, MIS_TEXT
      MENUITEM SEPARATOR
      MENUITEM "~Monitor tracing", IDM_OPTSMON, MIS_TEXT
      MENUITEM "~API monitoring...", IDM_OPTSAPI, MIS_TEXT
      MENUITEM "~File length monitoring...", IDM_OPTSLEN, MIS_TEXT
      MENUITEM SEPARATOR
      SUBMENU  "~Title/Action bar only", IDM_OPTSBAR, MIS_TEXT
      BEGIN
         MENUITEM "~Top of screen", IDM_OPTSTOP, MIS_TEXT
         MENUITEM "~Current position", IDM_OPTSCUR, MIS_TEXT
         MENUITEM "~Bottom of screen", IDM_OPTSBOT, MIS_TEXT
      END
      MENUITEM SEPARATOR
      MENUITEM "~Save window position", IDM_OPTSSWP, MIS_TEXT
      MENUITEM "~Restore window position", IDM_OPTRSWP, MIS_TEXT
   END
   SUBMENU     "~Help", IDM_HELPMENU, MIS_TEXT
   BEGIN
      MENUITEM "Help ~index", IDM_HELPIDX, MIS_TEXT
      MENUITEM "~General help", IDM_HELPGEN, MIS_TEXT
      MENUITEM "~Using help", IDM_HELPUSE, MIS_TEXT
      MENUITEM "~Keys help", IDM_HELPKEY, MIS_TEXT
      MENUITEM SEPARATOR
      MENUITEM "~Frequently asked questions", IDM_HELPFAQ, MIS_TEXT
      MENUITEM SEPARATOR
      MENUITEM "~Product information", IDM_HELPINFO, MIS_TEXT
   END
END

