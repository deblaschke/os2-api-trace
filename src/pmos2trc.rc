BEGIN
   DIALOG          "PMGPI APIs", DLG_CUSTGPI, 28, 12, 277, 106, WS_VISIBLE, FCF_TITLEBAR | FCF_SYSMENU
   BEGIN
      LTEXT        GPI_TEXT, DLG_GPITXT, 11, 88, 265, 8
      AUTOCHECKBOX "BIT", DLG_GPIBITCHK, 11, 72, 40, 10
      AUTOCHECKBOX "CORR", DLG_GPICORRCHK, 66, 72, 40, 10
      AUTOCHECKBOX "CTRL", DLG_GPICTRLCHK, 121, 72, 40, 10
      AUTOCHECKBOX "DEF", DLG_GPIDEFCHK, 176, 72, 40, 10
      AUTOCHECKBOX "DEV", DLG_GPIDEVCHK, 231, 72, 40, 10
      AUTOCHECKBOX "EDIT", DLG_GPIEDITCHK, 11, 57, 40, 10
      AUTOCHECKBOX "INK", DLG_GPIINKCHK, 66, 57, 40, 10
      AUTOCHECKBOX "LCID", DLG_GPILCIDCHK, 121, 57, 40, 10
      AUTOCHECKBOX "LCT", DLG_GPILCTCHK, 176, 57, 40, 10
      AUTOCHECKBOX "META", DLG_GPIMETACHK, 231, 57, 40, 10
      AUTOCHECKBOX "PATH", DLG_GPIPATHCHK, 11, 42, 40, 10
      AUTOCHECKBOX "POLY", DLG_GPIPOLYCHK, 66, 42, 40, 10
      AUTOCHECKBOX "PRIM", DLG_GPIPRIMCHK, 121, 42, 40, 10
      AUTOCHECKBOX "RGN", DLG_GPIRGNCHK, 176, 42, 40, 10
      AUTOCHECKBOX "SEG", DLG_GPISEGCHK, 231, 42, 40, 10
