      AUTORADIOBUTTON "", DLG_ALTDIRRAD, 11, 27, 8, 10, WS_TABSTOP
      LTEXT           ALT_DEFTEXT, DLG_ALTDEFTXT, 26, 42, 219, 8
      LTEXT           ALT_DIRTEXT1, DLG_ALTDIRTXT1, 26, 27, 78, 8
      ENTRYFIELD      "", DLG_ALTDIR, 65, 27, 118, 8, ES_MARGIN
      LTEXT           ALT_DIRTEXT2, DLG_ALTDIRTXT2, 195, 27, 50, 8
      PUSHBUTTON      "~OK", DLG_ALTOK, 13, 6, 40, 14
      PUSHBUTTON      "~Cancel", DLG_ALTCANCEL, 58, 6, 40, 14
      PUSHBUTTON      "~Default", DLG_ALTDEFAULT, 103, 6, 40, 14
