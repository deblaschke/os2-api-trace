   HELPITEM DLG_CUSTFIL, HLP_DLG_CUSTFIL, PNL_DLG_CUSTFIL
   HELPITEM DLG_CUSTGPI, HLP_DLG_CUSTGPI, PNL_DLG_CUSTGPI
   HELPITEM DLG_CUSTINT, HLP_DLG_CUSTINT, PNL_DLG_CUSTINT
   HELPITEM DLG_CUSTLVL, HLP_DLG_CUSTLVL, PNL_DLG_CUSTLVL
   HELPITEM DLG_CUSTTIM, HLP_DLG_CUSTTIM, PNL_DLG_CUSTTIM
#ifdef T_USERHOOK
   HELPITEM DLG_CUSTUSR, HLP_DLG_CUSTUSR, PNL_DLG_CUSTUSR
#endif
